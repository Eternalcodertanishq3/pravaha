/* ═══════════════════════════════════════════════════════════
   Pravaha v3.2 — Cyberpunk Dashboard TCSS
   Dark neon aesthetic with cyan / green / magenta accents.
   ═══════════════════════════════════════════════════════════ */

/* ── Global ──────────────────────────────────────────────── */

Screen {
    background: #0a0e14;
    color: #c0d0d8;
}

/* ── Header ──────────────────────────────────────────────── */

#dash-header {
    width: 100%;
    height: 4;
    background: #0a0e14;
    border: round #1a3a4a;
    content-align: center middle;
    text-align: center;
    margin: 0 0 0 0;
}

/* ── Main 3-column row ───────────────────────────────────── */

#main-row {
    width: 100%;
    height: 1fr;
    min-height: 24;
}

/* Left column — System Status + Flow Visualizer */

#left-col {
    width: 26;
    min-width: 24;
    height: 100%;
    border: round #1a3a4a;
    background: #0c1218;
}

#sys-status {
    height: 1fr;
    border-bottom: dashed #1a3a4a;
}

#flow-vis {
    height: 1fr;
}

/* Centre column — Flow Art + Avatar */

#center-flow {
    width: 1fr;
    height: 100%;
    border: round #1a3a4a;
    background: #0a0e14;
    content-align: center middle;
    text-align: center;
    overflow-y: auto;
}

#flow-top-art {
    width: 100%;
    content-align: center middle;
    text-align: center;
}

#center-avatar {
    width: 100%;
    content-align: center middle;
    text-align: center;
    margin: 0 0;
}

#flow-bottom-art {
    width: 100%;
    content-align: center middle;
    text-align: center;
}

#flow-tagline {
    width: 100%;
    content-align: center middle;
    text-align: center;
    margin: 0 0;
}

/* Right column — Active Agents + Pipeline */

#right-col {
    width: 28;
    min-width: 26;
    height: 100%;
    border: round #1a3a4a;
    background: #0c1218;
}

#active-agents {
    height: 1fr;
    border-bottom: dashed #1a3a4a;
}

#cur-pipeline {
    height: 1fr;
}

/* ── Bottom row — Metrics + Live Events ─────────────────── */

#bottom-row {
    width: 100%;
    height: 12;
    min-height: 10;
}

#metrics-bar {
    width: 1fr;
    height: 100%;
    border: round #1a3a4a;
    background: #0c1218;
    overflow-y: auto;
}

#live-events {
    width: 1fr;
    height: 100%;
    border: round #1a3a4a;
    background: #0c1218;
    overflow-y: auto;
}

/* ── Footer ──────────────────────────────────────────────── */

#dash-footer {
    width: 100%;
    height: 2;
    background: #0a0e14;
    border-top: dashed #1a3a4a;
    content-align: center middle;
    text-align: center;
}
