/* ══════════════════════════════════════════════════════════════
 * PRAVAHA v3.3 — CYBERPUNK TERMINAL THEME
 * Background: #0a0a0f  |  Primary: #00e5cc  |  Borders: #1a2a3a
 * ══════════════════════════════════════════════════════════════ */

/* ── Global ──────────────────────────────────────────────────── */

Screen {
    background: #0a0a0f;
    color: #c0c8d4;
}

/* ── Header ──────────────────────────────────────────────────── */

#dash-header {
    height: 4;
    background: #080810;
    border-bottom: solid #1a2a3a;
    content-align: center middle;
    text-align: center;
}

/* ── Main Row (3-column layout) ──────────────────────────────── */

#main-row {
    height: 1fr;
}

#left-col {
    width: 32;
    min-width: 28;
    border-right: solid #1a2a3a;
}

#center-col {
    width: 1fr;
}

#right-col {
    width: 36;
    min-width: 30;
    border-left: solid #1a2a3a;
}

/* ── Left Column Panels ──────────────────────────────────────── */

#sys-status {
    height: auto;
    max-height: 60%;
    background: #0c0c16;
    border-bottom: solid #1a2a3a;
    padding: 0 1;
}

#flow-vis {
    height: 1fr;
    background: #0a0a12;
    padding: 0 1;
}

/* ── Center Column ───────────────────────────────────────────── */

#center-top {
    height: auto;
    max-height: 45%;
}

#center-avatar {
    height: auto;
    max-height: 20;
    content-align: center middle;
    text-align: center;
    background: #080810;
    border: round #1a3a4a;
}

#chat-inline {
    height: 1fr;
    background: #0a0e14;
    border: round #1a3a4a;
    padding: 0 1;
}

#center-events {
    height: auto;
    max-height: 12;
    background: #0c0c16;
    border-top: solid #1a2a3a;
    padding: 0 1;
}

/* ── Right Column Panels ─────────────────────────────────────── */

#agent-grid {
    height: auto;
    max-height: 55%;
    background: #0c0c16;
    border-bottom: solid #1a2a3a;
    padding: 0 1;
}

#right-metrics {
    height: 1fr;
    background: #0a0a12;
    padding: 0 1;
}

/* ── Bottom Row ──────────────────────────────────────────────── */

#bottom-row {
    height: auto;
    max-height: 8;
    border-top: solid #1a2a3a;
}

#metrics-bar {
    width: 1fr;
    background: #0a0a0f;
    padding: 0 1;
}

#live-events {
    width: 1fr;
    background: #0a0a0f;
    padding: 0 1;
    border-left: solid #1a2a3a;
}

/* ── Wave ────────────────────────────────────────────────────── */

#wave-panel {
    height: 5;
    background: #0a0a0f;
    border-top: solid #0d1a24;
}

/* ── Footer ──────────────────────────────────────────────────── */

#dash-footer {
    height: 2;
    background: #080810;
    content-align: center middle;
    text-align: center;
    border-top: solid #1a2a3a;
}

/* ── Detail Screens (F-key overlays) ─────────────────────────── */

ChatScreen {
    background: #0a0a0f;
}

ChatHistory {
    height: 1fr;
    background: #0a0e14;
    border: round #1a3a4a;
    padding: 1 2;
}

SwarmScreen, AuditScreen, MetricsScreen, QueueScreen, RAGScreen, LogScreen {
    background: #0a0a0f;
}

/* ── Scrollbars ──────────────────────────────────────────────── */

VerticalScroll > .scrollbar {
    background: #0d0d18;
    color: #1a3a4a;
}

VerticalScroll > .scrollbar--bar {
    color: #00e5cc 40%;
}

/* ── Input ────────────────────────────────────────────────────── */

Input {
    background: #0d0d1a;
    border: solid #1a3a4a;
    color: #c0c8d4;
}

Input:focus {
    border: solid #00e5cc;
}

/* ── Header/Footer widgets ───────────────────────────────────── */

Header {
    background: #080810;
    color: #00e5cc;
}

Footer {
    background: #080810;
    color: #c0c8d4;
}

FooterKey {
    background: #0d0d1a;
    color: #00e5cc;
}

FooterKey:hover {
    background: #1a3a4a;
}
